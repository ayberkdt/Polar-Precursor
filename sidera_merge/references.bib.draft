% Liu et al. 2010 — DOI from the journal (Annales Geophysicae 28, 1633-1649);
% article text not reopened in this project (see registry notes).
@article{Liu2010ThermosphereDensityEm,
  author  = {Liu, R. and L{\"u}hr, H. and Doornbos, E. and Ma, S.-Y.},
  title   = {Thermospheric Mass Density Variations During Geomagnetic Storms and
             a Prediction Model Based on the Merging Electric Field},
  journal = {Annales Geophysicae},
  volume  = {28},
  number  = {9},
  pages   = {1633--1649},
  year    = {2010},
  doi     = {10.5194/angeo-28-1633-2010}
}

